<?xml version="1.0" encoding="utf-8"?>
<!-- TV Bakım. Paket adı ve imza anahtarı DEĞİŞMEZ (com.departures.tvbakim, tvbakim.jks): aksi halde kurulu sürüm güncellenmez.
     Bilinçli olarak YOK: WRITE_SECURE_SETTINGS, KILL_BACKGROUND_PROCESSES, QUERY_ALL_PACKAGES, şifresiz trafik (cleartext). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.departures.tvbakim"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- güncelleme: indirilen APK'yı sistem yükleyicisine verir (kullanıcı onaylar) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- uygulama kaldırma: yalnız sistemin kendi onay penceresi (ACTION_DELETE) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- gereksiz dosya taraması + çöp kutusu: Android 6–10 çalışma zamanı izni, 11+ kullanıcının açtığı "Tüm dosyalara erişim" -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- uygulama boyutları (StorageStatsManager): kullanıcı Ayarlar → Kullanım erişimi'nden açar -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ paket görünürlüğü: yalnız başlatıcıda görünen uygulamalar (QUERY_ALL_PACKAGES gerekmez) + eski sürüm -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="tr.tvbakim" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.departures.tvbakim.guncelleme"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
